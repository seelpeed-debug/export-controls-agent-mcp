# Dependencies
node_modules/

# Environment and credentials
# LAW_OC is a personal law.go.kr Open API account id. Never commit it.
.env
.env.*
!.env.example

# Local editor and agent settings.
# .claude/settings.local.json has historically held a LAW_OC value inline.
.claude/
.vscode/
.idea/

# Generated verification output (regenerate with: node verify/run-verification.mjs)
verify/verification-report.json

# Scratch files from data-source investigation
verify/*.xml
verify/*.txt
verify/law-raw-*.json

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# Logs
*.log
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# NOT ignored, on purpose: src/data/*.json
#
# Those files are generated by scripts/build-*.mjs, but the server require()s
# them at startup. A clone without them cannot run, and rebuilding needs network
# access to eCFR plus a LAW_OC account id. They are the regulation snapshots the
# tool's answers are dated against, so they belong in version control.
# ---------------------------------------------------------------------------
